{
  "name": "@exhibitos/manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {"node": "24.21.0", "npm": "11.19.0"},
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles app",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {"@tauri-apps/api": "2.12.1", "react": "19.3.0", "react-dom": "19.3.0"},
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1", "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "@playwright/test": "1.63.0", "vite": "8.3.2", "typescript": "6.0.3",
    "vitest": "5.0.3", "eslint": "10.11.0", "typescript-eslint": "8.71.0"
  }
}
