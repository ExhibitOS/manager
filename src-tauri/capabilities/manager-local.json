{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "manager-local",
  "description": "Only the bundled main Manager window can request guarded local lifecycle operations.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-manager-status",
    "allow-manager-remote",
    "allow-manager-remote-available",
    "allow-manager-remote-cancel",
    "allow-manager-update-status",
    "allow-manager-update-cancel",
    "allow-manager-update-references",
    "allow-manager-update-apply",
    "allow-manager-update-rollback-context",
    "allow-manager-update-rollback",
    "allow-manager-detect",
    "allow-manager-install",
    "allow-manager-action",
    "allow-manager-jobs",
    "allow-manager-logs",
    "allow-manager-open-exhibition",
    "allow-manager-open-oex",
    "allow-manager-verify-backup",
    "allow-manager-create-backup",
    "allow-manager-backup-jobs",
    "allow-manager-restore-backup",
    "allow-manager-restoration-context",
    "allow-manager-reconcile-helper",
    "allow-manager-helper-reconciliations",
    "allow-manager-maintenance-context",
    "allow-manager-cancel-maintenance",
    "allow-manager-maintenance-retries",
    "allow-manager-retry-backup",
    "allow-manager-retry-restoration",
    "allow-manager-installations",
    "allow-manager-create-installation",
    "allow-manager-select-installation",
    "allow-manager-hosted",
    "allow-manager-hosted-store",
    "allow-manager-hosted-connected",
    "allow-manager-hosted-disconnect",
    "allow-manager-hosted-choose-source",
    "allow-manager-hosted-link",
    "allow-manager-hosted-open-url",
    "allow-manager-hosted-resume",
    "allow-manager-hosted-resume-remote"
  ]
}
